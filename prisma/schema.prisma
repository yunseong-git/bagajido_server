// ============================================================================
// Bagajido MVP Prisma Schema v2.0
// ============================================================================
//
// 서비스 정의:
//   장소 기반 Moment + Sequence + SNS 서비스
//
// 핵심 도메인:
//   - User
//   - Place / PlaceCategory / PlaceExternalSource
//   - Moment / MomentImage
//   - PlaceRating / RatingMetric
//   - MomentLike
//   - MomentComment / MomentCommentLike
//   - UserFollow / FollowReason
//   - Sequence / SequenceMoment
//
// 핵심 개념:
//   Moment:
//     사용자가 특정 Place에서 남긴 하나의 방문 경험 / SNS 콘텐츠.
//     기존 PlaceVisit과 이미지형 Moment의 역할을 통합함.
//
//   Sequence:
//     여러 Moment를 사용자가 원하는 순서로 묶은 여행 이야기.
//     기존 Record를 대체함.
//
//   Diary:
//     별도 DB Entity가 아님.
//     User의 Moment / Sequence를 조합하여 보여주는 View 개념.
//
//   Stats:
//     별도 DB Entity가 아님.
//     User의 Moment / Rating / PlaceCategory 등을 기반으로 계산하는 View 개념.
//
//   Place Summary:
//     Moment / Rating 데이터를 기반으로 집계 및 AI 요약하는 View 개념.
//     AI 결과 저장 구조는 실제 AI 기능 구현 단계에서 추가함.
//
// 주요 설계 원칙:
//   1. Bagajido User / Place는 자체 UUID를 사용함.
//   2. Supabase Auth / TourAPI는 외부 연결 대상이며 Domain PK로 사용하지 않음.
//   3. Place 폐업/운영종료는 ARCHIVED로 보존함.
//   4. Moment는 한 번의 Place 경험을 나타내며 같은 Place에 여러 Moment 생성 가능함.
//   5. Moment는 사진 없이도 존재할 수 있으며 이미지는 MomentImage로 관리함.
//   6. Rating은 Moment에 필수 종속하며 Moment 하나당 최대 1개임.
//   7. PRIVATE Moment의 개별 정보는 외부 공개하지 않음.
//   8. PRIVATE Moment의 Rating은 익명 Place 집계에는 포함 가능함.
//   9. PRIVATE Moment의 content / image는 공개 AI Summary 입력으로 사용하지 않음.
//   10. MomentComment는 PUBLIC + ACTIVE Moment에만 신규 작성 가능함.
//   11. MomentComment Reply는 MVP에서 1-depth까지만 허용함.
//   12. Ranking / Stats cache 값은 원본 Domain 테이블에 중복 저장하지 않음.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS - USER
// ============================================================================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

// ============================================================================
// ENUMS - PLACE
// ============================================================================

enum PlaceStatus {
  ACTIVE
  ARCHIVED
}

enum PlaceExternalProvider {
  TOUR_API
  INTERNAL
}

// ============================================================================
// ENUMS - MOMENT
// ============================================================================

enum MomentExperienceType {
  VISIT_ONLY
  FREE_EXPERIENCE
  PAID_EXPERIENCE
}

enum VisitorType {
  UNKNOWN
  LOCAL
  DOMESTIC_VISITOR
  INTERNATIONAL_VISITOR
}

enum MomentVerificationType {
  SELF_REPORTED
  LOCATION
  RECEIPT
  BOOKING
  ADMIN
}

enum MomentVisibility {
  PUBLIC
  PRIVATE
}

enum MomentStatus {
  ACTIVE
  DELETED
  HIDDEN
}

enum StorageProvider {
  S3
  R2
}

// ============================================================================
// ENUMS - RATING
// ============================================================================

enum RatingMetricDirection {
  HIGHER_IS_BETTER
  HIGHER_IS_WORSE
}

// ============================================================================
// ENUMS - MOMENT COMMENT
// ============================================================================

enum MomentCommentStatus {
  ACTIVE
  DELETED
  HIDDEN
}

// ============================================================================
// ENUMS - SEQUENCE
// ============================================================================

enum SequenceStatus {
  DRAFT
  PUBLISHED
  DELETED
  HIDDEN
}

enum SequenceVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

// ============================================================================
// USER
// ============================================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  // Supabase auth.users.id
  authUserId String? @unique @db.Uuid

  username    String  @unique @db.VarChar(30)
  displayName String  @db.VarChar(50)
  bio         String? @db.VarChar(500)

  // 전체 URL이 아니라 Storage object key만 저장함.
  profileImageKey String?

  // ISO 3166-1 alpha-2
  nationalityCode      String? @db.Char(2)
  residenceCountryCode String? @db.Char(2)

  // 예: ko-KR, en-US, ja-JP
  preferredLocale String @default("ko-KR") @db.VarChar(10)

  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  withdrawnAt DateTime?  @db.Timestamptz(6)

  moments            Moment[]
  momentLikes        MomentLike[]
  momentComments     MomentComment[]
  momentCommentLikes MomentCommentLike[]

  sequences Sequence[]

  // 내가 다른 사용자를 팔로우한 관계.
  followingRelations UserFollow[] @relation("Follower")

  // 다른 사용자가 나를 팔로우한 관계.
  followerRelations UserFollow[] @relation("Following")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("users")
}

// ============================================================================
// PLACE CATEGORY
// ============================================================================

model PlaceCategory {
  id String @id @default(uuid()) @db.Uuid

  parentId String? @db.Uuid

  key    String  @unique @db.VarChar(50)
  nameKo String  @db.VarChar(100)
  nameEn String? @db.VarChar(100)

  parent   PlaceCategory?  @relation("PlaceCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children PlaceCategory[] @relation("PlaceCategoryHierarchy")

  places Place[]

  ratingMetrics CategoryRatingMetric[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([parentId])
  @@map("place_categories")
}

// ============================================================================
// PLACE
// ============================================================================

model Place {
  id String @id @default(uuid()) @db.Uuid

  categoryId String? @db.Uuid

  name String @db.VarChar(200)

  normalizedName    String? @db.VarChar(200)
  address           String?
  normalizedAddress String?
  postalCode        String? @db.VarChar(20)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  businessNumber String? @db.VarChar(20)

  phone       String? @db.VarChar(50)
  websiteUrl  String?
  description String? @db.Text

  operationInfo Json? @db.JsonB
  priceInfo     Json? @db.JsonB

  status        PlaceStatus @default(ACTIVE)
  archivedAt    DateTime?   @db.Timestamptz(6)
  archiveReason String?

  category PlaceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  externalSources PlaceExternalSource[]

  // Place의 사용자 경험 원본.
  moments Moment[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([categoryId])
  @@index([name])
  @@index([normalizedName])
  @@index([businessNumber])
  @@index([status])
  @@index([latitude, longitude])
  @@map("places")
}

// ============================================================================
// PLACE EXTERNAL SOURCE
// ============================================================================

model PlaceExternalSource {
  id String @id @default(uuid()) @db.Uuid

  placeId String @db.Uuid

  provider   PlaceExternalProvider
  externalId String                @db.VarChar(255)

  externalType String? @db.VarChar(100)

  sourceUpdatedAt DateTime? @db.Timestamptz(6)
  syncedAt        DateTime? @db.Timestamptz(6)

  // Bagajido Domain에서 아직 정식 컬럼으로 사용하지 않는 외부 원본 데이터.
  rawData Json? @db.JsonB

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([provider, externalId])
  @@index([placeId])
  @@map("place_external_sources")
}

// ============================================================================
// MOMENT
// ============================================================================

model Moment {
  // 하나의 장소에서 남긴 하나의 방문 경험 / SNS 콘텐츠.
  id String @id @default(uuid()) @db.Uuid

  userId  String @db.Uuid
  placeId String @db.Uuid

  // 실제 장소 방문 날짜.
  visitedOn DateTime @db.Date

  // 정확한 방문 시각을 아는 경우에만 저장함.
  visitedAt DateTime? @db.Timestamptz(6)

  experienceType MomentExperienceType @default(VISIT_ONLY)

  // LOCAL 여부는 User의 고정 속성이 아니라
  // 이 Place를 방문했을 당시의 관계임.
  visitorType VisitorType @default(UNKNOWN)

  // 일반 사용자는 SELF_REPORTED로 생성.
  // LOCATION / RECEIPT / BOOKING / ADMIN은 검증 로직을 통해 변경함.
  verificationType MomentVerificationType @default(SELF_REPORTED)
  verifiedAt       DateTime?              @db.Timestamptz(6)

  // Moment 본문.
  // 사진이나 Rating 없이 방문 사실만 기록하는 것도 허용함.
  content      String? @db.VarChar(2000)
  languageCode String? @db.VarChar(10)

  // PRIVATE는 본인 Diary에서만 노출함.
  visibility MomentVisibility @default(PRIVATE)

  // 사용자가 삭제하더라도 실제 row는 즉시 hard delete하지 않음.
  status    MomentStatus @default(ACTIVE)
  deletedAt DateTime?    @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  place Place @relation(fields: [placeId], references: [id], onDelete: Restrict)

  // 한 Moment에는 Rating 최대 1개.
  rating PlaceRating?

  images   MomentImage[]
  likes    MomentLike[]
  comments MomentComment[]

  // 하나의 Moment는 여러 Sequence에 재사용 가능함.
  sequences SequenceMoment[]

  // Sequence 대표 Moment로 사용될 수 있음.
  coverOfSequences Sequence[] @relation("SequenceCoverMoment")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Diary
  @@index([userId, status, visitedOn])
  // Place 공개 Moment 목록
  @@index([placeId, visibility, status, createdAt])
  // 동일 Place 재방문 조회
  @@index([userId, placeId])
  // LOCAL / DOMESTIC / INTERNATIONAL 통계
  @@index([placeId, visitorType])
  @@map("moments")
}

// ============================================================================
// MOMENT IMAGE
// ============================================================================

model MomentImage {
  id String @id @default(uuid()) @db.Uuid

  momentId String @db.Uuid

  // 전체 URL 대신 Storage Provider + Object Key.
  storageProvider StorageProvider
  objectKey       String

  // 하나의 Moment 내 이미지 표시 순서.
  sortOrder Int @default(0)

  // 실제 사진 촬영 시각을 아는 경우.
  takenAt DateTime? @db.Timestamptz(6)

  width     Int?
  height    Int?
  mimeType  String? @db.VarChar(100)
  sizeBytes Int?

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([storageProvider, objectKey])
  @@index([momentId, sortOrder])
  @@map("moment_images")
}

// ============================================================================
// RATING METRIC DEFINITION
// ============================================================================

model RatingMetricDefinition {
  id String @id @default(uuid()) @db.Uuid

  // 예: TASTE, VALUE, CLEANLINESS, ACCESSIBILITY
  key String @unique @db.VarChar(50)

  labelKo     String  @db.VarChar(100)
  labelEn     String? @db.VarChar(100)
  description String? @db.VarChar(500)

  direction RatingMetricDirection @default(HIGHER_IS_BETTER)

  // 기존 Rating 보존을 위해 삭제보다 비활성화함.
  isActive Boolean @default(true)

  categories CategoryRatingMetric[]
  values     PlaceRatingMetric[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive])
  @@map("rating_metric_definitions")
}

// ============================================================================
// CATEGORY <-> RATING METRIC
// ============================================================================

model CategoryRatingMetric {
  categoryId         String @db.Uuid
  metricDefinitionId String @db.Uuid

  sortOrder  Int     @default(0)
  isRequired Boolean @default(false)

  category         PlaceCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  metricDefinition RatingMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([categoryId, metricDefinitionId])
  @@index([categoryId, sortOrder])
  @@map("category_rating_metrics")
}

// ============================================================================
// PLACE RATING
// ============================================================================

model PlaceRating {
  id String @id @default(uuid()) @db.Uuid

  // Rating은 실제 Moment에 필수 종속함.
  // 하나의 Moment에는 Rating 최대 1개.
  momentId String @unique @db.Uuid

  // MVP 1~5 정수.
  overallScore Int @db.SmallInt

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  metrics PlaceRatingMetric[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("place_ratings")
}

// ============================================================================
// PLACE RATING METRIC
// ============================================================================

model PlaceRatingMetric {
  ratingId           String @db.Uuid
  metricDefinitionId String @db.Uuid

  score Int @db.SmallInt

  rating           PlaceRating            @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  metricDefinition RatingMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)

  @@id([ratingId, metricDefinitionId])
  @@index([metricDefinitionId])
  @@map("place_rating_metrics")
}

// ============================================================================
// MOMENT LIKE
// ============================================================================

model MomentLike {
  userId   String @db.Uuid
  momentId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // 한 User가 하나의 Moment에 좋아요 한 번만 가능.
  @@id([userId, momentId])
  @@index([momentId, createdAt])
  @@map("moment_likes")
}

// ============================================================================
// MOMENT COMMENT
// ============================================================================

model MomentComment {
  id String @id @default(uuid()) @db.Uuid

  momentId String @db.Uuid
  userId   String @db.Uuid

  // null이면 최상위 댓글.
  // 값이 있으면 답글.
  parentId String? @db.Uuid

  // Soft delete 후 Thread 구조를 보존하기 위해 nullable.
  content String? @db.VarChar(2000)

  languageCode String? @db.VarChar(10)

  status MomentCommentStatus @default(ACTIVE)

  editedAt  DateTime? @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  parent  MomentComment?  @relation("MomentCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies MomentComment[] @relation("MomentCommentReplies")

  likes MomentCommentLike[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([momentId, status, createdAt])
  @@index([userId, createdAt])
  @@index([parentId, createdAt])
  @@map("moment_comments")
}

// ============================================================================
// MOMENT COMMENT LIKE
// ============================================================================

model MomentCommentLike {
  userId    String @db.Uuid
  commentId String @db.Uuid

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment MomentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([userId, commentId])
  @@index([commentId, createdAt])
  @@map("moment_comment_likes")
}

// ============================================================================
// USER FOLLOW
// ============================================================================

model UserFollow {
  id String @id @default(uuid()) @db.Uuid

  followerId  String @db.Uuid
  followingId String @db.Uuid

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  reasons FollowReason[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
  @@map("user_follows")
}

// ============================================================================
// FOLLOW REASON DEFINITION
// ============================================================================

model FollowReasonDefinition {
  id String @id @default(uuid()) @db.Uuid

  // 예:
  // MOMENT_STYLE
  // RATING_OBJECTIVITY
  // VISIT_INSIGHT
  // TRAVEL_STYLE
  // VALUE_SENSE
  // PLACE_TASTE
  key String @unique @db.VarChar(50)

  labelKo     String  @db.VarChar(100)
  labelEn     String? @db.VarChar(100)
  description String? @db.VarChar(500)

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  follows FollowReason[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("follow_reason_definitions")
}

// ============================================================================
// FOLLOW REASON
// ============================================================================

model FollowReason {
  followId           String @db.Uuid
  reasonDefinitionId String @db.Uuid

  follow           UserFollow             @relation(fields: [followId], references: [id], onDelete: Cascade)
  reasonDefinition FollowReasonDefinition @relation(fields: [reasonDefinitionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([followId, reasonDefinitionId])
  @@index([reasonDefinitionId, createdAt])
  @@map("follow_reasons")
}

// ============================================================================
// SEQUENCE
// ============================================================================

model Sequence {
  // 여러 Moment를 사용자가 원하는 순서로 묶은 하나의 여행 이야기.
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.VarChar(2000)

  // Storage URL을 저장하지 않고 Moment 자체를 Cover로 참조함.
  coverMomentId String? @db.Uuid

  visibility SequenceVisibility @default(PUBLIC)
  status     SequenceStatus     @default(DRAFT)

  publishedAt DateTime? @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  coverMoment Moment? @relation("SequenceCoverMoment", fields: [coverMomentId], references: [id], onDelete: SetNull)

  moments SequenceMoment[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId, status, createdAt])
  @@index([userId, status, publishedAt])
  @@index([coverMomentId])
  @@map("sequences")
}

// ============================================================================
// SEQUENCE <-> MOMENT
// ============================================================================

model SequenceMoment {
  sequenceId String @db.Uuid
  momentId   String @db.Uuid

  // 실제 방문시간과 무관한 Sequence 내 이야기 순서.
  sortOrder Int

  // 원본 Moment.content를 변경하지 않고
  // Sequence 문맥에서 추가 설명을 붙일 수 있음.
  note String? @db.VarChar(1000)

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  moment   Moment   @relation(fields: [momentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // 같은 Sequence에 동일 Moment 중복 사용 불가.
  @@id([sequenceId, momentId])
  @@index([sequenceId, sortOrder])
  @@index([momentId])
  @@map("sequence_moments")
}

// ============================================================================
// MVP v2.0 - DB / Application Invariants
// ============================================================================
//
// Prisma Schema만으로 완전히 표현하기 어려운 규칙.
//
// [PostgreSQL CHECK 권장]
//
//   1. user_follows.followerId <> user_follows.followingId
//
//   2. place_ratings.overallScore BETWEEN 1 AND 5
//
//   3. place_rating_metrics.score BETWEEN 1 AND 5
//
//   4. moment_images.sortOrder >= 0
//
//   5. sequence_moments.sortOrder >= 0
//
//
// [NestJS Transaction / Service 검증]
//
//   1. Moment 생성 시 userId는 Request의 CurrentUser.id를 사용함.
//      Client가 임의의 userId를 지정할 수 없음.
//
//   2. ARCHIVED Place라도 과거 방문 Moment 기록은 허용함.
//
//   3. 일반 사용자가 생성하는 Moment.verificationType은
//      SELF_REPORTED로 강제함.
//
//   4. MomentLike / MomentComment 신규 작성은
//      Moment.status == ACTIVE && Moment.visibility == PUBLIC인 경우만 허용함.
//
//   5. PUBLIC Moment를 PRIVATE로 변경해도 기존 Like / Comment를 삭제하지 않음.
//      PRIVATE 상태에서는 외부에서 노출하지 않고,
//      다시 PUBLIC이 되면 기존 데이터가 재노출될 수 있음.
//
//   6. MomentComment.parentId가 존재하면:
//      - parent.momentId == comment.momentId
//      - parent.parentId == null
//      을 검증하여 Reply를 1-depth까지만 허용함.
//
//   7. Moment / MomentComment 삭제는 일반적으로 soft delete함.
//      DELETED / HIDDEN 콘텐츠는 일반 공개 조회에서 제외함.
//
//   8. PlaceRating 생성/수정은
//      moment.userId == currentUser.id인 경우만 허용함.
//
//   9. PlaceRatingMetric은 Moment의 PlaceCategory에 연결된
//      ACTIVE RatingMetricDefinition만 허용함.
//
//   10. PRIVATE Moment의 Rating은 Place 익명 통계에 포함할 수 있음.
//       단, 개별 Moment / 작성자 / Rating 상세 / Image / content는 공개하지 않음.
//
//   11. 공개 Place Summary의 AI 입력에는
//       PUBLIC + ACTIVE Moment.content만 사용할 수 있음.
//       PRIVATE Moment.content는 AI Summary 원본에서 제외함.
//
//   12. Place Rating 집계는 visibility와 관계없이 ACTIVE Moment의 Rating을 사용함.
//       DELETED / HIDDEN Moment Rating은 일반 Place 집계에서 제외하는 방향.
//
//   13. 다른 User의 Stats 공개 계산은 PUBLIC + ACTIVE Moment만 사용함.
//       본인의 Stats는 PUBLIC + PRIVATE ACTIVE Moment를 모두 사용할 수 있음.
//
//   14. Sequence에 추가되는 Moment는 MVP에서
//       sequence.userId == moment.userId를 강제함.
//
//   15. Sequence.coverMomentId는 해당 SequenceMoment에 포함된 Moment인지 검증함.
//
//   16. Sequence visibility가 Moment visibility를 확장하지 않음.
//       PUBLIC Sequence라도 PRIVATE Moment는 외부에 노출하지 않음.
//
//   17. Follow 생성 시 ACTIVE FollowReasonDefinition을
//       최소 1개 이상 선택하도록 MVP에서 강제함.
//
//   18. Ranking Score / User Rating Strictness / Stats Snapshot은
//       현재 원본 Entity에 저장하지 않음.
//       향후 계산 비용이 문제가 되는 시점에 별도 Cache / Snapshot 계층을 도입함.
//
